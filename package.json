{
  "name": "aura",
  "version": "0.1.0",
  "private": true,
  "description": "Team Aura: help friend groups find and meet other friend groups",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "db:check": "npm run db:check -w server",
    "db:reset": "npm run db:reset -w server",
    "db:migrate": "npm run db:migrate -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "verify:slice": "npm run verify:slice -w server",
    "verify:decline": "npm run verify:decline -w server",
    "verify:chat": "npm run verify:chat -w server",
    "verify:receipts": "npm run verify:receipts -w server",
    "verify:messages": "npm run verify:messages -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
